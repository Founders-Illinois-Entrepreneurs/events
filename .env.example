# Copy to .env.local and fill in. Never commit .env.local.
# These are the only two settings the site needs.

# Neon: Dashboard > your project > Connect. Use the *pooled* connection string
# (host contains "-pooler"), ending in ?sslmode=verify-full.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Password organizers type at /admin to run events. Make it long; share it only with organizers.
ADMIN_PASSWORD=
